# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Production Server Port
PORT=3000
NODE_ENV=development

# Authentication & Security
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-for-infosbrain"
ADMIN_EMAIL="admin@infosbrain.com"
ADMIN_PASSWORD="Admin@123456"

# External Cron Trigger Secret (optional)
CRON_SECRET="your-secure-cron-secret-key"

# Database path (optional - defaults to ./data/infosbrain.db)
DATABASE_PATH="./data/infosbrain.db"

# SMTP Transactional Email Settings (Optional - contact notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="InfosBrain Inquiries <info@infosbrain.com>"
SMTP_SECURE=false
