# ==========================================
# InfosBrain Environment Variables Template
# ==========================================

# Frontend API URL (leave blank for local proxy, or set to production backend URL)
VITE_API_URL=
VITE_BASE=

# Production Server Port & Host
PORT=
NODE_ENV=

# Authentication & Security
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# External Cron Trigger Secret (Optional)
CRON_SECRET=

# Database Configuration (Optional - defaults to ./data/infosbrain.db)
DATABASE_PATH=

# SMTP Transactional Email Settings (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=

# Third-party Integrations (Optional)
GEMINI_API_KEY=
